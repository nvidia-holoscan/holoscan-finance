+// Escape hatch for hosts whose mlx5 firmware steering cannot create jump
+// actions / non-zero flow groups ("cannot create jump action (Operation not
+// permitted)" at init, seen on IGX Thor + DOCA-OFED 25.10 under dv_flow_en=1):
+// DAQIRI_RX_FLOW_GROUP=0 programs standard IPv4/UDP RX flows directly in
+// group 0 like testpmd does. Group 0 needs neither the ETH jump rule nor the
+// send-to-kernel fallback (flow isolation already delivers unmatched traffic
+// to the kernel), so both become no-ops for it.
+static uint32_t standard_rx_flow_group() {
+  static const uint32_t group = []() -> uint32_t {
+    if (const char* env = std::getenv("DAQIRI_RX_FLOW_GROUP")) {
+      const int value = std::atoi(env);
+      if (value >= 0) { return static_cast<uint32_t>(value); }
+    }
+    return kStandardRxFlowGroup;
+  }();
+  return group;
+}
