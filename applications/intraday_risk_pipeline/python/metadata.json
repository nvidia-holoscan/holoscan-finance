{
    "$schema": "urn:holohub:application:v1",
    "application": {
        "name": "intraday_risk_pipeline",
        "authors": [
            {
                "name": "Bruce Hashemian",
                "affiliation": "NVIDIA"
            }
        ],
        "language": ["Python"],
        "version": "0.1.0",
        "changelog": {
            "0.1.0": "Add an offline intraday portfolio-risk reference pipeline"
        },
        "holoscan_sdk": {
            "minimum_required_version": "4.3.0",
            "tested_versions": ["4.3.0"]
        },
        "platforms": ["x86_64", "aarch64"],
        "tags": ["Financial Services", "Risk Management", "Streaming Analytics"],
        "ranking": 2,
        "requirements": {
            "operators": [
                "market_data_replay_op",
                "rolling_statistics_op",
                "portfolio_risk_op"
            ]
        },
        "default_mode": "default",
        "modes": {
            "default": {
                "description": "Replay deterministic synthetic ticks and log portfolio risk",
                "run": {
                    "command": "python3 <holohub_app_bin>/intraday_risk_pipeline.py",
                    "workdir": "holohub_app_bin"
                }
            }
        }
    }
}
