# Run Python from .venv (or $PY) against this checkout, with the stack size and CUDA
# library path the Holoscan wheel needs:  ./scripts/runenv -m holoscan.equities.stream
set -euo pipefail
REPO="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." && pwd )"
PYBIN="${PY:-$REPO/.venv/bin/python}"
[ -x "$PYBIN" ] || { echo "error: no Python at $PYBIN; create .venv (see README) or set PY=python3" >&2; exit 1; }

ulimit -s 32768 || true
# Pip-installed NVIDIA libraries (cudart, nvrtc, cublas, ...) for Holoscan and CuPy.
NVLIBS="$(find "$(dirname "$(dirname "$PYBIN")")" -type d -path '*/nvidia/*/lib' 2>/dev/null | tr '\n' ':')"
export LD_LIBRARY_PATH="${NVLIBS}${LD_LIBRARY_PATH:-}"
# scripts/sitecustomize.py puts this checkout's python/holoscan ahead of any installed copy.
export HOLOSCAN_FINANCE_REPO="$REPO"
export PYTHONPATH="$REPO/scripts${PYTHONPATH:+:$PYTHONPATH}"
exec "$PYBIN" "$@"
